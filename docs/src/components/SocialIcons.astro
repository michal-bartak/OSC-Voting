---
// Overrides Starlight's default header SocialIcons to append KVR OneSynthChallenge
// links. This Starlight version's `social` config only accepts a fixed set of
// platform keys (no SoundCloud / generic website icon), so these are added here.
import Default from '@astrojs/starlight/components/SocialIcons.astro';
---

<Default><slot /></Default>

<a href="https://sites.google.com/site/kvrosc/" rel="me" class="sl-flex" target="_blank">
	<span class="sr-only">KVR OneSynthChallenge site</span>
	<svg
		aria-hidden="true"
		width="16"
		height="16"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
	>
		<circle cx="12" cy="12" r="9" />
		<path d="M3 12h18" />
		<path d="M12 3c2.5 2.6 2.5 15.4 0 18M12 3c-2.5 2.6-2.5 15.4 0 18" />
	</svg>
</a>

<a href="https://soundcloud.com/kvrosc" rel="me" class="sl-flex" target="_blank">
